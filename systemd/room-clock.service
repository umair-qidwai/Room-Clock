[Unit]
Description=Room Clock
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/Room-Clock
EnvironmentFile=-%h/.config/room-clock/env
ExecStart=%h/Room-Clock/.venv/bin/uvicorn app:app --host 127.0.0.1 --port 8780
Restart=on-failure
RestartSec=3
UMask=0077

[Install]
WantedBy=default.target
